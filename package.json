{
  "name": "@ookam147/opencode-scheduler-tui",
  "version": "1.4.1",
  "description": "Native OpenCode schedule task center with session-aware TUI management",
  "main": "dist/native/server.js",
  "types": "dist/native/server.d.ts",
  "type": "module",
  "files": [
    "dist/native",
    "docs/native-migration.md",
    "docs/legacy-readme.md",
    "docs/legacy-readme.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/native/server.d.ts",
      "import": "./dist/native/server.js"
    },
    "./server": {
      "types": "./dist/native/server.d.ts",
      "import": "./dist/native/server.js"
    },
    "./tui": {
      "types": "./dist/native/tui.d.ts",
      "import": "./dist/native/tui.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc --emitDeclarationOnly",
    "check:exports": "bun --preload @opentui/solid/runtime-plugin-support scripts/check-exports.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build && bun run check:exports",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "typecheck": "tsc --noEmit",
    "test": "bun test src --preload @opentui/solid/runtime-plugin-support"
  },
  "keywords": [
    "opencode",
    "plugin",
    "scheduler",
    "cron",
    "launchd",
    "systemd",
    "automation",
    "jobs"
  ],
  "author": "Benjamin Shafii, ookam147",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ookam147/opencode-scheduler-tui.git"
  },
  "bugs": {
    "url": "https://github.com/ookam147/opencode-scheduler-tui/issues"
  },
  "homepage": "https://github.com/ookam147/opencode-scheduler-tui#readme",
  "dependencies": {
    "@opencode/plugin": "2.2.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/theme": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/keymap": "0.8.0",
    "@opentui/solid": "0.8.0",
    "bun": "^1.3.14",
    "bun-types": "latest",
    "cron-parser": "^5.4.0",
    "solid-js": "^1.9.17",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.3",
    "@opentui/core": ">=0.8.0",
    "@opentui/keymap": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.9"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/keymap": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  }
}
